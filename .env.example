# Copy to .env and fill in. PLACEHOLDERS ONLY — no real values committed.
#
# RPC_URL        — Solana RPC endpoint. Helius recommended for production
#                  (getSignaturesForAddress pagination + low latency).
#                  Dev/test: https://api.devnet.solana.com or a free public node.
# DATABASE_URL   — Postgres connection string, e.g.
#                  postgres://user:password@localhost:5432/launchfolio
# JWT_SECRET     — long random string for signing auth sessions. Generate with:
#                  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# PORT           — API listen port (default 3000).
# PROGRAM_ID     — Pump program to index (default: pump.fun launch program).
# POLL_INTERVAL_MS — indexer poll interval in ms (default 15000).

RPC_URL=
DATABASE_URL=
JWT_SECRET=
PORT=3000
PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
POLL_INTERVAL_MS=15000
